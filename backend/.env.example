# ============================================
# DocVault Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# NEVER commit .env to git

# --- Google OAuth2 Credentials ---
# Get from: https://console.cloud.google.com
# Steps: APIs & Services > Credentials > Create OAuth 2.0 Client ID
# Application type: Web application
# Authorized redirect URIs: http://localhost:5000/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# --- Anthropic API Key ---
# Get from: https://console.anthropic.com/settings/keys
# Free tier: $5 credit on signup
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- App Config ---
PORT=5000
FRONTEND_URL=http://localhost:3000
SESSION_SECRET=change_this_to_a_random_string_32chars_min

# --- Optional: Google Drive Root Folder ---
# Leave empty to use root of My Drive
# Or paste a folder ID from a Drive URL: drive.google.com/drive/folders/FOLDER_ID_HERE
GOOGLE_DRIVE_ROOT_FOLDER_ID=
